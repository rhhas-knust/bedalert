# ---- BedAlert API settings. Copy to .env for local use; set these in Render for production.

# dev | production. In dev: demo secrets are filled in, /v1/dev/staff-token exists,
# OTP codes are returned in the API response, SMS are only printed to the log.
BEDALERT_ENV=dev

# Postgres. Locally: your own Postgres. Production: the Supabase project's
# connection string (Connect -> "Session pooler").
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bedalert

# Comma-separated frontend URLs allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# ---- Staff login = Supabase Auth. Set ONE of these (Project Settings -> JWT Keys).
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=<legacy JWT secret>

# ---- Secrets BedAlert owns. Production: at least 32 random characters each, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# CITIZEN_TOKEN_SECRET=
# HASH_PEPPER=              # changing this invalidates every hospital API key
# USSD_CALLBACK_SECRET=     # goes in the aggregator callback URL: /v1/ussd?key=...

# ---- SMS: console (dev only) | africastalking
SMS_PROVIDER=console
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=

# ---- Business rules (minutes)
# STALE_AFTER_MINUTES=60
# HOLD_MINUTES_EMERGENCY=45
# HOLD_MINUTES_WARD=120
