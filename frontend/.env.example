# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.

# The BedAlert API (no trailing slash). Locally: the FastAPI server.
VITE_API_URL=http://localhost:8000

# Staff sign-in via Supabase Auth. Leave both empty locally to use the dev demo accounts.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<publishable key>
